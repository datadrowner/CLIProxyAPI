diff --git a/internal/web/limits.go b/internal/web/limits.go
new file mode 100644
index 0000000..5370b5e
--- /dev/null
+++ b/internal/web/limits.go
@@ -0,0 +1,375 @@
+package web
+
+import (
+	"context"
+	"net/http"
+	"regexp"
+	"strings"
+	"time"
+	"unicode"
+
+	"github.com/OzoneH3/CLIProxyAPI_unraid/internal/bootstrap"
+	"github.com/OzoneH3/CLIProxyAPI_unraid/internal/cliproxy"
+)
+
+// keyView is a limited client key as shown in the WebUI; the raw key is only
+// returned on creation and through the explicit reveal route.
+type keyView struct {
+	ID           string             `json:"id"`
+	Name         string             `json:"name"`
+	Hint         string             `json:"hint"`
+	Subscription string             `json:"subscription"`
+	TokenLimit   int64              `json:"token_limit"`
+	Period       string             `json:"period"`
+	AccountShare float64            `json:"account_share"`
+	Main         bool               `json:"main"`
+	Usage        *cliproxy.KeyUsage `json:"usage,omitempty"`
+}
+
+type limitInput struct {
+	ID           string  `json:"id"`
+	Name         string  `json:"name"`
+	Subscription string  `json:"subscription"`
+	TokenLimit   int64   `json:"token_limit"`
+	Period       string  `json:"period"`
+	AccountShare float64 `json:"account_share"`
+	Confirm      bool    `json:"confirm"`
+}
+
+// keyViews lists the main key and the limited keys with their budget state.
+// Account shares are labeled with account names instead of auth indexes.
+func (s *Server) keyViews(ctx context.Context, limits cliproxy.Limits) []keyView {
+	usage, _ := s.Client.KeyUsage(ctx)
+
+	labels := map[string]string{}
+	if accounts, e := s.Client.Accounts(ctx); e == nil {
+		for _, a := range accounts {
+			labels[a.Index] = accountLabel(a)
+		}
+	}
+	main := s.Client.Key()
+	views := []keyView{{ID: cliproxy.KeyID(main), Name: "Main key (WebUI)", Hint: keyHint(main), Main: true}}
+	for _, k := range limits.Keys {
+		v := keyView{ID: cliproxy.KeyID(k.Key), Name: k.Name, Hint: keyHint(k.Key), Subscription: k.Subscription, TokenLimit: k.TokenLimit, Period: k.Period, AccountShare: k.AccountShare}
+		if u, ok := usage[v.ID]; ok {
+			for i := range u.AccountShares {
+				sh := &u.AccountShares[i]
+				if sh.Account = labels[sh.AuthIndex]; sh.Account == "" {
+					sh.Account = "Removed account"
+				}
+			}
+			if u.AccountShares == nil {
+				u.AccountShares = []cliproxy.AccountShare{}
+			}
+			v.Usage = &u
+		}
+		views = append(views, v)
+	}
+	return views
+}
+
+var planName = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9 _.-]{0,39}$`)
+
+func keyHint(key string) string {
+	if len(key) <= 12 {
+		return "••••"
+	}
+	return key[:7] + "••••" + key[len(key)-4:]
+}
+
+func validName(name string) bool {
+	if len(name) > 64 {
+		return false
+	}
+	for _, r := range name {
+		if unicode.IsControl(r) {
+			return false
+		}
+	}
+	return true
+}
+
+func validPeriod(period string) bool {
+	switch period {
+	case "", "total", "daily", "weekly", "monthly":
+		return true
+	}
+	d, e := time.ParseDuration(period)
+	return e == nil && d >= time.Minute && d <= 366*24*time.Hour
+}
+
+func validLimit(in limitInput, plans []cliproxy.Plan) string {
+	if !validName(in.Name) {
+		return "Name must be at most 64 characters"
+	}
+	if in.TokenLimit < 0 || in.TokenLimit > 1e13 {
+		return "Token limit is out of range"
+	}
+	if !validPeriod(in.Period) {
+		return "Period must be total, daily, weekly, monthly, or a duration like 5h"
+	}
+	if in.AccountShare < 0 || in.AccountShare > 100 {
+		return "Account share must be between 0 and 100 percent"
+	}
+	if in.Subscription != "" {
+		for _, p := range plans {
+			if p.Name == in.Subscription {
+				return ""
+			}
+		}
+		return "Unknown subscription plan"
+	}
+	return ""
+}
+
+func (s *Server) limitsAPI(w http.ResponseWriter, r *http.Request, path string) {
+	ctx := r.Context()
+	switch {
+	case path == "/api/limits" && r.Method == "GET":
+		limits, e := s.Client.Limits(ctx)
+		if e != nil {
+			problem(w, 502, "Key limits unavailable")
+			return
+		}
+		reply(w, 200, map[string]any{"plans": limits.Subscriptions, "keys": s.keyViews(ctx, limits)})
+	case path == "/api/limits/keys" && r.Method != "GET":
+		var in limitInput
+		if !decode(w, r, &in) {
+			return
+		}
+		in.Name, in.Subscription, in.Period = strings.TrimSpace(in.Name), strings.TrimSpace(in.Subscription), strings.TrimSpace(in.Period)
+		s.limitsMu.Lock()
+		defer s.limitsMu.Unlock()
+		limits, e := s.Client.Limits(ctx)
+		if e != nil {
+			problem(w, 502, "Key limits unavailable")
+			return
+		}
+		created := ""
+		switch r.Method {
+		case "POST":
+			if msg := validLimit(in, limits.Subscriptions); msg != "" {
+				problem(w, 400, msg)
+				return
+			}
+			if len(limits.Keys) >= 200 {
+				problem(w, 400, "Too many keys")
+				return
+			}
+			key, errKey := bootstrap.Secret("sk-cpa-")
+			if errKey != nil {
+				problem(w, 500, "Could not generate a key")
+				return
+			}
+			limits.Keys = append(limits.Keys, cliproxy.LimitedKey{Key: key, Name: in.Name, Subscription: in.Subscription, TokenLimit: in.TokenLimit, Period: in.Period, AccountShare: in.AccountShare})
+			created = key
+		case "PATCH", "DELETE":
+			idx := -1
+			for i, k := range limits.Keys {
+				if cliproxy.KeyID(k.Key) == in.ID {
+					idx = i
+				}
+			}
+			if idx < 0 {
+				problem(w, 404, "Unknown key")
+				return
+			}
+			if r.Method == "DELETE" {
+				if !in.Confirm {
+					problem(w, 400, "Confirm deletion first")
+					return
+				}
+				limits.Keys = append(limits.Keys[:idx], limits.Keys[idx+1:]...)
+				break
+			}
+			if msg := validLimit(in, limits.Subscriptions); msg != "" {
+				problem(w, 400, msg)
+				return
+			}
+			k := &limits.Keys[idx]
+			k.Name, k.Subscription, k.TokenLimit, k.Period, k.AccountShare = in.Name, in.Subscription, in.TokenLimit, in.Period, in.AccountShare
+		default:
+			problem(w, 405, "Method not allowed")
+			return
+		}
+		if e = s.Client.SaveLimits(ctx, limits); e != nil {
+			problem(w, 502, "Saving key limits failed")
+			return
+		}
+		if created != "" {
+			reply(w, 200, map[string]string{"id": cliproxy.KeyID(created), "key": created})
+			return
+		}
+		reply(w, 200, map[string]bool{"ok": true})
+	case strings.HasPrefix(path, "/api/limits/keys/") && r.Method == "GET":
+		id := strings.TrimPrefix(path, "/api/limits/keys/")
+		limits, e := s.Client.Limits(ctx)
+		if e != nil {
+			problem(w, 502, "Key limits unavailable")
+			return
+		}
+		for _, k := range limits.Keys {
+			if cliproxy.KeyID(k.Key) == id {
+				reply(w, 200, map[string]string{"key": k.Key})
+				return
+			}
+		}
+		problem(w, 404, "Unknown key")
+	case path == "/api/limits/plans" && r.Method == "PUT":
+		var in struct {
+			Plans []cliproxy.Plan `json:"plans"`
+		}
+		if !decode(w, r, &in) {
+			return
+		}
+		seen := map[string]bool{}
+		for i := range in.Plans {
+			p := &in.Plans[i]
+			p.Name, p.Period = strings.TrimSpace(p.Name), strings.TrimSpace(p.Period)
+			if !planName.MatchString(p.Name) || seen[p.Name] {
+				problem(w, 400, "Plan names must be unique: letters, digits, space, dot, dash or underscore")
+				return
+			}
+			if p.TokenLimit < 0 || p.TokenLimit > 1e13 || !validPeriod(p.Period) || p.AccountShare < 0 || p.AccountShare > 100 {
+				problem(w, 400, "Invalid plan limit or period")
+				return
+			}
+			seen[p.Name] = true
+		}
+		if len(in.Plans) > 50 {
+			problem(w, 400, "Too many plans")
+			return
+		}
+		s.limitsMu.Lock()
+		defer s.limitsMu.Unlock()
+		limits, e := s.Client.Limits(ctx)
+		if e != nil {
+			problem(w, 502, "Key limits unavailable")
+			return
+		}
+		for _, k := range limits.Keys {
+			if k.Subscription != "" && !seen[k.Subscription] {
+				problem(w, 400, "Plan \""+k.Subscription+"\" is still used by a key; change those keys first")
+				return
+			}
+		}
+		limits.Subscriptions = in.Plans
+		if e = s.Client.SaveLimits(ctx, limits); e != nil {
+			problem(w, 502, "Saving plans failed")
+			return
+		}
+		reply(w, 200, map[string]bool{"ok": true})
+	case path == "/api/usage" && r.Method == "GET":
+		s.usageOverview(w, r)
+	case path == "/api/analytics" && r.Method == "GET":
+		month := r.URL.Query().Get("month")
+		if month != "" {
+			if _, e := time.Parse("2006-01", month); e != nil {
+				problem(w, 400, "Month must be YYYY-MM")
+				return
+			}
+		}
+		a, e := s.Client.Analytics(ctx, month)
+		if e != nil {
+			problem(w, 502, "Analytics unavailable")
+			return
+		}
+		a.Keys = s.keyLabels(a.Keys)
+		accounts := map[string]string{}
+		if list, errAccounts := s.Client.Accounts(ctx); errAccounts == nil {
+			for _, acc := range list {
+				accounts[acc.Index] = accountLabel(acc)
+			}
+		}
+		reply(w, 200, map[string]any{"analytics": a, "accounts": accounts})
+	default:
+		problem(w, 404, "Not found")
+	}
+}
+
+// keyLabels names the WebUI main key and falls back to upstream labels.
+func (s *Server) keyLabels(upstream map[string]string) map[string]string {
+	labels := map[string]string{}
+	for id, label := range upstream {
+		labels[id] = label
+	}
+	labels[cliproxy.KeyID(s.Client.Key())] = "Main key (WebUI)"
+	return labels
+}
+
+func accountLabel(a cliproxy.Account) string {
+	if a.Email != "" {
+		return a.Provider + " · " + a.Email
+	}
+	return a.Provider
+}
+
+// usageOverview combines key budgets, this month's analytics and account limits.
+func (s *Server) usageOverview(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	a, e := s.Client.Analytics(ctx, "")
+	if e != nil {
+		problem(w, 502, "Usage unavailable")
+		return
+	}
+	limits, _ := s.Client.Limits(ctx)
+
+	accounts, _ := s.Client.Accounts(ctx)
+
+	type totals struct {
+		Requests int64   `json:"requests"`
+		Tokens   int64   `json:"tokens"`
+		CostUSD  float64 `json:"cost_usd"`
+	}
+	byKey, byAuth := map[string]*totals{}, map[string]*totals{}
+	add := func(m map[string]*totals, id string, row cliproxy.UsageRow) {
+		t := m[id]
+		if t == nil {
+			t = &totals{}
+			m[id] = t
+		}
+		t.Requests += row.Requests
+		t.Tokens += row.TotalTokens
+		t.CostUSD += row.CostUSD
+	}
+	for _, row := range a.Rows {
+		add(byKey, row.KeyID, row)
+		add(byAuth, row.AuthIndex, row)
+	}
+
+	type keyRow struct {
+		keyView
+		Month totals `json:"month"`
+	}
+	keys := []keyRow{}
+	for _, v := range s.keyViews(ctx, limits) {
+		keys = append(keys, keyRow{keyView: v})
+	}
+	for i := range keys {
+		if t := byKey[keys[i].ID]; t != nil {
+			keys[i].Month = *t
+		}
+	}
+
+	type accountRow struct {
+		ID       string                 `json:"id"`
+		Label    string                 `json:"label"`
+		Plan     string                 `json:"plan"`
+		Status   string                 `json:"status"`
+		Disabled bool                   `json:"disabled"`
+		Limits   []cliproxy.QuotaWindow `json:"limits"`
+		Month    totals                 `json:"month"`
+	}
+	rows := []accountRow{}
+	for _, acc := range accounts {
+		row := accountRow{ID: acc.ID, Label: accountLabel(acc), Plan: acc.Plan, Status: acc.Status, Disabled: acc.Disabled, Limits: acc.Limits}
+		if row.Limits == nil {
+			row.Limits = []cliproxy.QuotaWindow{}
+		}
+		if t := byAuth[acc.Index]; t != nil {
+			row.Month = *t
+		}
+		rows = append(rows, row)
+	}
+	reply(w, 200, map[string]any{"month": a.Month, "keys": keys, "accounts": rows})
+}
diff --git a/internal/web/limits_test.go b/internal/web/limits_test.go
new file mode 100644
index 0000000..5b3ce7c
