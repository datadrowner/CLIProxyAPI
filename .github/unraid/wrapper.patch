+    row.append(element('small', 'This month: ' + tokensText(a.month.tokens) + ' tokens · ' + fmtInt.format(a.month.requests) + ' requests · ' + usdText(a.month.cost_usd)));
+    return row;
+  }));
+}
+
+// ---- API keys ----
+function periodValue(select, custom) { return select.value === 'custom' ? custom.value.trim() : select.value; }
+function setPeriod(select, custom, value) {
+  const known = ['total', 'daily', 'weekly', 'monthly'];
+  const v = value || 'total';
+  select.value = known.includes(v) ? v : 'custom'; custom.hidden = select.value !== 'custom'; custom.value = known.includes(v) ? '' : v;
+}
+function syncKeyMode() {
+  const mode = $('key-mode').value;
+  $('key-tokens-fields').hidden = mode !== 'tokens'; $('key-plan-fields').hidden = mode !== 'plan';
+  $('key-plan-empty').hidden = plans.length > 0;
+}
+function resetKeyForm() {
+  $('key-form').reset(); $('key-id').value = ''; $('key-form-title').textContent = 'Create a key'; $('key-submit').textContent = 'Create key'; $('key-cancel').hidden = true;
+  setPeriod($('key-period'), $('key-period-custom'), 'total'); syncKeyMode();
+}
+function editKey(k) {
+  $('key-id').value = k.id; $('key-name').value = k.name; $('key-form-title').textContent = 'Edit ' + (k.name || k.hint); $('key-submit').textContent = 'Save changes'; $('key-cancel').hidden = false;
+  $('key-mode').value = k.subscription ? 'plan' : (k.token_limit > 0 ? 'tokens' : 'full');
+  $('key-limit').value = k.token_limit > 0 ? k.token_limit : ''; $('key-share').value = k.account_share > 0 ? k.account_share : ''; setPeriod($('key-period'), $('key-period-custom'), k.period);
+  if (k.subscription) $('key-plan').value = k.subscription;
+  syncKeyMode(); $('key-form').scrollIntoView({behavior: 'smooth'});
+}
+async function keysPage() {
+  const d = await api('limits');
+  plans = d.plans.map(p => ({name: p.name, token_limit: p['token-limit'] || 0, period: p.period || '', share: p['account-share'] || 0})); keyRows = d.keys;
+  $('key-plan').replaceChildren(...plans.map(p => { const o = element('option', p.name + ' · ' + planText(p)); o.value = p.name; return o; }));
+  syncKeyMode();
+  $('key-list').replaceChildren(...keyRows.map(k => {
+    const card = element('article', '');
+    card.append(element('h3', k.name || 'Unnamed key'), element('code', k.hint), element('p', limitText(k)));
+    if (k.usage && !k.usage.unlimited) card.append(meter(k.usage.used_tokens, k.usage.token_limit, (k.name || k.hint) + ' budget'));
+    appendShares(card, k);
+    if (k.main) {
+      card.append(element('p', 'Generated by this WebUI; rotate it on API Access.'), button('Copy key', async () => { const r = await api('key'); await copy(r.key); }));
+    } else {
+      card.append(
+        button('Copy key', async () => { const r = await api('limits/keys/' + k.id); await copy(r.key); }),
+        button('Edit limit', () => editKey(k)),
+        button('Delete', async () => { if (!confirm('Delete key "' + (k.name || k.hint) + '"? Clients using it stop working immediately.')) return; await api('limits/keys', 'DELETE', {id: k.id, confirm: true}); message('Key deleted.'); await keysPage(); }));
+      card.lastChild.classList.add('danger');
+    }
+    return card;
+  }));
+  $('plan-list').replaceChildren(...(plans.length ? plans.map(p => {
+    const row = element('div', ''); row.className = 'usage-head';
+    const used = keyRows.filter(k => k.subscription === p.name).length;
+    row.append(element('span', p.name + ' — ' + planText(p) + ' · ' + used + ' key' + (used === 1 ? '' : 's')),
+      button('Remove', async () => { await savePlans(plans.filter(x => x.name !== p.name)); message('Plan removed.'); await keysPage(); }));
+    return row;
+  }) : [element('p', 'No plans yet.')]));
+}
+const planText = p => [p.token_limit > 0 ? tokensText(p.token_limit) + ' tokens ' + periodText(p.period) : '', p.share > 0 ? shareText(p.share) + ' of each account' : ''].filter(Boolean).join(' · ') || 'full usage';
+const savePlans = list => api('limits/plans', 'PUT', {plans: list.map(x => ({name: x.name, 'token-limit': x.token_limit, period: x.period, 'account-share': x.share || 0}))});
+document.querySelectorAll('select.period').forEach(s => s.addEventListener('change', () => { s.nextElementSibling.hidden = s.value !== 'custom'; }));
+$('key-mode').addEventListener('change', syncKeyMode);
+$('key-cancel').addEventListener('click', resetKeyForm);
+$('key-form').addEventListener('submit', action(async () => {
+  const mode = $('key-mode').value, id = $('key-id').value;
+  const body = {name: $('key-name').value.trim(), subscription: '', token_limit: 0, period: '', account_share: parseFloat($('key-share').value) || 0};
+  if (body.account_share < 0 || body.account_share > 100) throw new Error('Account share must be between 0 and 100 percent.');
+  if (mode === 'tokens') { body.token_limit = parseInt($('key-limit').value, 10) || 0; body.period = periodValue($('key-period'), $('key-period-custom')); if (body.token_limit <= 0) throw new Error('Enter a token budget greater than 0.'); }
+  if (mode === 'plan') { body.subscription = $('key-plan').value; if (!body.subscription) throw new Error('Add a subscription plan first.'); }
+  if (body.period === 'total') body.period = '';
+  if (id) { await api('limits/keys', 'PATCH', {id, ...body}); message('Key updated.'); $('key-created').hidden = true; }
+  else { const r = await api('limits/keys', 'POST', body); $('key-created-value').textContent = r.key; $('key-created').hidden = false; message('Key created.'); }
+  resetKeyForm(); await keysPage();
+}));
+$('key-created-copy').addEventListener('click', action(() => copy($('key-created-value').textContent)));
+$('plan-form').addEventListener('submit', action(async () => {
+  const p = {name: $('plan-name').value.trim(), token_limit: parseInt($('plan-limit').value, 10) || 0, period: periodValue($('plan-period'), $('plan-period-custom')), share: parseFloat($('plan-share').value) || 0};
+  if (!p.name) throw new Error('Enter a plan name.');
+  if (p.token_limit <= 0 && p.share <= 0) throw new Error('Enter a token budget, an account share, or both.');
+  if (p.share < 0 || p.share > 100) throw new Error('Account share must be between 0 and 100 percent.');
+  if (p.period === 'total') p.period = '';
+  await savePlans(plans.filter(x => x.name !== p.name).concat([p]));
+  $('plan-form').reset(); setPeriod($('plan-period'), $('plan-period-custom'), 'monthly'); message('Plan saved.'); await keysPage();
+}));
+
+// ---- Analytics ----
+function table(id, headers, rows) {
+  const t = $(id); t.replaceChildren();
+  const head = document.createElement('tr'); headers.forEach(h => head.append(element('th', h))); t.append(head);
+  if (!rows.length) { const tr = document.createElement('tr'); const td = element('td', 'No usage recorded.'); td.colSpan = headers.length; tr.append(td); t.append(tr); return; }
+  rows.forEach(r => { const tr = document.createElement('tr'); r.forEach((c, i) => { const td = element('td', c); if (i > 0) td.className = 'num'; tr.append(td); }); t.append(tr); });
+}
+function group(rows, keyFn) {
+  const m = new Map();
+  rows.forEach(r => { const k = keyFn(r); const g = m.get(k) || {requests: 0, input: 0, cacheRead: 0, cacheWrite: 0, output: 0, total: 0, cost: 0, unpriced: 0}; g.requests += r.requests; g.input += r.input_tokens; g.cacheRead += r.cache_read_tokens; g.cacheWrite += r.cache_write_tokens; g.output += r.output_tokens; g.total += r.total_tokens; g.cost += r.cost_usd; g.unpriced += r.unpriced_tokens; m.set(k, g); });
+  return [...m.entries()].sort((a, b) => b[1].cost - a[1].cost || b[1].total - a[1].total);
+}
+const groupRow = (label, g) => [label, fmtInt.format(g.requests), tokensText(g.input), tokensText(g.cacheRead), tokensText(g.cacheWrite), tokensText(g.output), tokensText(g.total), g.unpriced === g.total && g.total > 0 ? 'n/a' : usdText(g.cost)];
+const groupHeaders = first => [first, 'Requests', 'Input', 'Cache read', 'Cache write', 'Output', 'Total tokens', 'API cost'];
+function card(title, value, note) { const a = element('article', ''); a.append(element('h2', title), element('p', value)); a.lastChild.className = 'big'; if (note) a.append(element('small', note)); return a; }
+async function analytics(month) {
+  const d = await api('analytics' + (month ? '?month=' + encodeURIComponent(month) : ''));
+  const a = d.analytics, rows = a.rows;
+  const select = $('analytics-month'), months = a.months.includes(a.month) ? a.months : [a.month].concat(a.months);
+  select.replaceChildren(...months.map(m => { const o = element('option', m); o.value = m; return o; })); select.value = a.month;
