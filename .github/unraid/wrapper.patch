+package web
+
+import (
+	"context"
+	"net/http"
+	"regexp"
+	"slices"
+	"strings"
+	"sync"
+	"time"
+	"unicode"
+
+	"github.com/OzoneH3/CLIProxyAPI_unraid/internal/bootstrap"
+	"github.com/OzoneH3/CLIProxyAPI_unraid/internal/cliproxy"
+)
+
+// keyView is a limited client key as shown in the WebUI; the raw key is only
+// returned on creation and through the explicit reveal route.
+type keyView struct {
+	ID           string             `json:"id"`
+	Name         string             `json:"name"`
+	Hint         string             `json:"hint"`
+	Subscription string             `json:"subscription"`
+	TokenLimit   int64              `json:"token_limit"`
+	Period       string             `json:"period"`
+	AccountShare float64            `json:"account_share"`
+	Models       []string           `json:"allowed_models"`
+	Efforts      []string           `json:"allowed_efforts"`
+	Main         bool               `json:"main"`
+	Usage        *cliproxy.KeyUsage `json:"usage,omitempty"`
+}
+
+type limitInput struct {
+	ID           string   `json:"id"`
+	Name         string   `json:"name"`
+	Subscription string   `json:"subscription"`
+	TokenLimit   int64    `json:"token_limit"`
+	Period       string   `json:"period"`
+	AccountShare float64  `json:"account_share"`
+	Models       []string `json:"allowed_models"`
+	Efforts      []string `json:"allowed_efforts"`
+	Confirm      bool     `json:"confirm"`
+}
+
+// efforts are the reasoning efforts a key or plan can be restricted to.
+var efforts = []string{"none", "auto", "minimal", "low", "medium", "high", "xhigh", "max"}
+
+// cleanList trims and de-duplicates entries, dropping empty ones.
+func cleanList(values []string) []string {
+	out := []string{}
+	for _, v := range values {
+		v = strings.TrimSpace(v)
+		if v != "" && !slices.Contains(out, v) {
+			out = append(out, v)
+		}
+	}
+	return out
+}
+
+// validAccess checks allowed model patterns and efforts; it returns a message on error.
+func validAccess(models, allowedEfforts []string) string {
+	if len(models) > 200 {
+		return "Too many models"
+	}
+	for _, m := range models {
+		if len(m) > 128 || !validName(m) {
+			return "Model names must be at most 128 characters"
+		}
+	}
+	for _, e := range allowedEfforts {
+		if !slices.Contains(efforts, strings.ToLower(e)) {
+			return "Unknown reasoning effort \"" + e + "\""
+		}
+	}
+	return ""
+}
+
+// keyViews lists the main key and the limited keys with their budget state.
+// Account shares are labeled with account names instead of auth indexes.
+func (s *Server) keyViews(ctx context.Context, limits cliproxy.Limits) []keyView {
+	usage, _ := s.Client.KeyUsage(ctx)
+
+	labels := map[string]string{}
+	if accounts, e := s.Client.Accounts(ctx); e == nil {
+		for _, a := range accounts {
+			labels[a.Index] = accountLabel(a)
+		}
+	}
+	main := s.Client.Key()
+	views := []keyView{{ID: cliproxy.KeyID(main), Name: "Main key (WebUI)", Hint: keyHint(main), Main: true}}
+	for _, k := range limits.Keys {
+		v := keyView{ID: cliproxy.KeyID(k.Key), Name: k.Name, Hint: keyHint(k.Key), Subscription: k.Subscription, TokenLimit: k.TokenLimit, Period: k.Period, AccountShare: k.AccountShare, Models: cleanList(k.AllowedModels), Efforts: cleanList(k.AllowedEfforts)}
+		if u, ok := usage[v.ID]; ok {
+			for i := range u.AccountShares {
+				sh := &u.AccountShares[i]
+				if sh.Account = labels[sh.AuthIndex]; sh.Account == "" {
+					sh.Account = "Removed account"
+				}
+			}
+			if u.AccountShares == nil {
+				u.AccountShares = []cliproxy.AccountShare{}
+			}
+			v.Usage = &u
+		}
+		views = append(views, v)
+	}
+	return views
+}
+
+var planName = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9 _.-]{0,39}$`)
+
+func keyHint(key string) string {
+	if len(key) <= 12 {
+		return "••••"
+	}
+	return key[:7] + "••••" + key[len(key)-4:]
+}
+
+func validName(name string) bool {
+	if len(name) > 64 {
+		return false
+	}
+	for _, r := range name {
+		if unicode.IsControl(r) {
+			return false
+		}
+	}
+	return true
+}
+
+func validPeriod(period string) bool {
+	switch period {
+	case "", "total", "daily", "weekly", "monthly":
+		return true
+	}
+	d, e := time.ParseDuration(period)
+	return e == nil && d >= time.Minute && d <= 366*24*time.Hour
+}
+
+func validLimit(in limitInput, plans []cliproxy.Plan) string {
+	if !validName(in.Name) {
+		return "Name must be at most 64 characters"
+	}
+	if in.TokenLimit < 0 || in.TokenLimit > 1e13 {
+		return "Token limit is out of range"
+	}
+	if !validPeriod(in.Period) {
+		return "Period must be total, daily, weekly, monthly, or a duration like 5h"
+	}
+	if in.AccountShare < 0 || in.AccountShare > 100 {
+		return "Account share must be between 0 and 100 percent"
+	}
+	if msg := validAccess(in.Models, in.Efforts); msg != "" {
+		return msg
+	}
+	if in.Subscription != "" {
+		for _, p := range plans {
+			if p.Name == in.Subscription {
+				return ""
+			}
+		}
+		return "Unknown subscription plan"
+	}
+	return ""
+}
+
+func (s *Server) limitsAPI(w http.ResponseWriter, r *http.Request, path string) {
+	ctx := r.Context()
+	switch {
+	case path == "/api/limits" && r.Method == "GET":
+		limits, e := s.Client.Limits(ctx)
+		if e != nil {
+			problem(w, 502, "Key limits unavailable")
+			return
+		}
+		// Models lists what the proxy currently offers, so the UI can offer them as choices.
+		models, _ := s.Client.Models(ctx)
+		if models == nil {
+			models = []string{}
+		}
+		reply(w, 200, map[string]any{"plans": limits.Subscriptions, "keys": s.keyViews(ctx, limits), "models": models, "efforts": efforts})
