+  shares.forEach(s => {
+    const line = element('div', ''); line.className = 'usage-head';
+    line.append(element('span', s.account + ' · ' + s.window), element('span', shareText(s.used_percent) + ' of ' + shareText(s.share_percent) + ' used (account at ' + shareText(s.account_used_percent) + ')' + (whenText(s.resets_at) ? ' · resets ' + whenText(s.resets_at) : '')));
