+  table('analytics-keys', groupHeaders('API key'), group(rows, r => r.key_id).map(([id, g]) => groupRow(keyLabel(id), g)));
+  table('analytics-models', groupHeaders('Model'), group(rows, r => r.model).map(([m, g]) => groupRow(m, g)));
+  table('analytics-accounts', groupHeaders('Account'), group(rows, r => r.auth_index).map(([idx, g]) => groupRow(d.accounts[idx] || (idx ? 'Removed account' : 'Unknown'), g)));
+  $('pricing-source').textContent = a.pricing_source;
+  table('analytics-pricing', ['Model', 'ID prefix', 'Input', 'Cache write 5m', 'Cache write 1h', 'Cache read', 'Output'],
+    a.pricing.map(p => [p.name + (p.legacy ? ' (legacy)' : '') + (p.long_prompt ? ' (≤' + fmtInt.format(p.long_prompt_threshold) + ' prompt; above: $' + p.long_prompt.input + ' / $' + p.long_prompt.output + ')' : '') + (p.fast_mode ? ' · fast mode 2×' : ''), p.model, '$' + p.input, '$' + p.cache_write_5m, '$' + p.cache_write_1h, '$' + p.cache_read, '$' + p.output]));
