+// CallbackByURL submits a pasted callback URL to the pending login it belongs to,
+// matched by the provider callback address and the OAuth state. It works after a
+// page reload or a new WebUI session, as long as the login has not expired.
+func (m *Manager) CallbackByURL(ctx context.Context, raw string) (string, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if len(raw) > 8192 {
+		return "", errors.New("invalid callback")
+	}
+	u, e := url.Parse(raw)
+	if e != nil {
+		return "", errors.New("invalid callback URL")
+	}
+	state := u.Query().Get("state")
+	now := m.Now()
+	for _, s := range Catalog {
+		if s.Device || u.Host != s.CallbackHost || u.Path != s.CallbackPath {
+			continue
+		}
+		for _, f := range m.flows {
+			if f.Provider == s.ID && state != "" && f.State == state && now.Before(f.Expires) {
+				return s.ID, m.submit(ctx, f, raw)
+			}
+		}
+		return "", errors.New("no pending login matches this callback; start Connect again")
+	}
+	return "", errors.New("invalid callback URL")
+}
