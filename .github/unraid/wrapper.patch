@@ -0,0 +1,200 @@
+package web
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/OzoneH3/CLIProxyAPI_unraid/internal/cliproxy"
+	"github.com/OzoneH3/CLIProxyAPI_unraid/internal/mock"
+	"github.com/OzoneH3/CLIProxyAPI_unraid/internal/security"
+	"golang.org/x/crypto/bcrypt"
+)
+
+func limitsFixture(t *testing.T) (*mock.Server, func(method, path, body string) *httptest.ResponseRecorder) {
+	t.Helper()
+	m := mock.New()
+	m.Connected = true
+	up := httptest.NewServer(m.Handler())
+	t.Cleanup(up.Close)
+	h, _ := bcrypt.GenerateFromPassword([]byte("correct-password"), bcrypt.MinCost)
+	s := New(cliproxy.New(up.URL, m.Secret, m.Key, ""), security.New(h, false))
+	s.Alive.Store(true)
+	handler := s.Handler()
+	raw := func(method, path, body string, cookie *http.Cookie, csrf string) *httptest.ResponseRecorder {
+		r := httptest.NewRequest(method, "http://localhost"+path, strings.NewReader(body))
+		r.Header.Set("Origin", "http://localhost")
+		r.Header.Set("Content-Type", "application/json")
+		r.Header.Set("X-CSRF-Token", csrf)
+		if cookie != nil {
+			r.AddCookie(cookie)
+		}
+		w := httptest.NewRecorder()
+		handler.ServeHTTP(w, r)
+		return w
+	}
+	w := raw("POST", "/api/login", `{"password":"correct-password"}`, nil, "")
+	cookie := w.Result().Cookies()[0]
+	var login map[string]string
+	_ = json.Unmarshal(w.Body.Bytes(), &login)
+	return m, func(method, path, body string) *httptest.ResponseRecorder {
+		return raw(method, path, body, cookie, login["csrf"])
+	}
+}
+
+func decodeBody(t *testing.T, w *httptest.ResponseRecorder, out any) {
+	t.Helper()
+	if w.Code != 200 {
+		t.Fatalf("status %d: %s", w.Code, w.Body)
+	}
+	if e := json.Unmarshal(w.Body.Bytes(), out); e != nil {
+		t.Fatal(e)
+	}
+}
+
+func TestKeyAndPlanManagement(t *testing.T) {
+	m, do := limitsFixture(t)
+	var list struct {
+		Plans []cliproxy.Plan `json:"plans"`
+		Keys  []keyView       `json:"keys"`
+	}
+	decodeBody(t, do("GET", "/api/limits", ""), &list)
+	if len(list.Keys) != 1 || !list.Keys[0].Main || strings.Contains(list.Keys[0].Hint, m.Key) {
+		t.Fatalf("initial keys = %+v", list.Keys)
+	}
+
+	if w := do("POST", "/api/limits/keys", `{"name":"alice","subscription":"pro"}`); w.Code != 400 {
+		t.Fatal("unknown plan accepted", w.Code)
+	}
+	if w := do("PUT", "/api/limits/plans", `{"plans":[{"name":"pro","token-limit":1000,"period":"monthly"},{"name":"pro"}]}`); w.Code != 400 {
+		t.Fatal("duplicate plan accepted", w.Code)
+	}
+	if w := do("PUT", "/api/limits/plans", `{"plans":[{"name":"pro","token-limit":1000,"period":"fortnightly"}]}`); w.Code != 400 {
+		t.Fatal("bad period accepted", w.Code)
+	}
+	decodeBody(t, do("PUT", "/api/limits/plans", `{"plans":[{"name":"pro","token-limit":1000,"period":"monthly"}]}`), &map[string]bool{})
+
+	var created struct{ ID, Key string }
+	decodeBody(t, do("POST", "/api/limits/keys", `{"name":"alice","subscription":"pro"}`), &created)
+	if !strings.HasPrefix(created.Key, "sk-cpa-") || created.ID != cliproxy.KeyID(created.Key) {
+		t.Fatalf("created = %+v", created)
+	}
+	var small struct{ ID, Key string }
+	decodeBody(t, do("POST", "/api/limits/keys", `{"name":"trial","token_limit":500,"period":"5h"}`), &small)
+
+	decodeBody(t, do("GET", "/api/limits", ""), &list)
+	if len(list.Keys) != 3 || list.Keys[1].Subscription != "pro" || list.Keys[2].TokenLimit != 500 || list.Keys[2].Usage == nil || list.Keys[2].Usage.RemainingTokens != 490 {
+		t.Fatalf("keys = %+v", list.Keys)
+	}
+	if strings.Contains(do("GET", "/api/limits", "").Body.String(), created.Key) {
+		t.Fatal("list exposes raw key")
+	}
+	var revealed struct{ Key string }
+	decodeBody(t, do("GET", "/api/limits/keys/"+created.ID, ""), &revealed)
+	if revealed.Key != created.Key {
+		t.Fatal("reveal returned wrong key")
+	}
+
+	if w := do("PUT", "/api/limits/plans", `{"plans":[]}`); w.Code != 400 {
+		t.Fatal("removed a plan still in use", w.Code)
+	}
+	decodeBody(t, do("PATCH", "/api/limits/keys", `{"id":"`+created.ID+`","name":"alice","token_limit":2000,"period":"daily"}`), &map[string]bool{})
+	decodeBody(t, do("PUT", "/api/limits/plans", `{"plans":[]}`), &map[string]bool{})
+	if w := do("DELETE", "/api/limits/keys", `{"id":"`+small.ID+`"}`); w.Code != 400 {
+		t.Fatal("delete without confirmation accepted", w.Code)
+	}
+	decodeBody(t, do("DELETE", "/api/limits/keys", `{"id":"`+small.ID+`","confirm":true}`), &map[string]bool{})
+
+	var saved cliproxy.Limits
+	if e := json.Unmarshal(m.Limits, &saved); e != nil {
+		t.Fatal(e)
+	}
+	if len(saved.Keys) != 1 || saved.Keys[0].Key != created.Key || saved.Keys[0].Subscription != "" || saved.Keys[0].TokenLimit != 2000 || saved.Keys[0].Period != "daily" || len(saved.Subscriptions) != 0 {
+		t.Fatalf("saved limits = %+v", saved)
+	}
+}
+
+func TestUsageOverviewAndAnalytics(t *testing.T) {
+	m, do := limitsFixture(t)
+	var overview struct {
+		Month string `json:"month"`
+		Keys  []struct {
+			Main  bool `json:"main"`
+			Month struct {
+				Tokens  int64   `json:"tokens"`
+				CostUSD float64 `json:"cost_usd"`
+			} `json:"month"`
+		} `json:"keys"`
+		Accounts []struct {
+			Label  string                 `json:"label"`
+			Limits []cliproxy.QuotaWindow `json:"limits"`
+			Month  struct {
+				Requests int64 `json:"requests"`
+			} `json:"month"`
+		} `json:"accounts"`
