+document.querySelectorAll('[data-goto]').forEach(b => b.addEventListener('click', () => document.querySelector('nav [data-page="' + b.dataset.goto + '"]').click()));
+const baseSignedIn = signedIn;
+signedIn = async function () { await baseSignedIn(); try { await usageOverview(); } catch (e) { message(e.message); } };
+resetKeyForm(); setPeriod($('plan-period'), $('plan-period-custom'), 'monthly');
