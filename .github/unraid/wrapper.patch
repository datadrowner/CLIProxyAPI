+func TestConnectReplacesPendingLogin(t *testing.T) {
+	m, _ := fixture(t)
+	ctx := context.Background()
+	first, e := m.Start(ctx, "codex", "owner")
+	if e != nil {
+		t.Fatal(e)
+	}
+	second, e := m.Start(ctx, "codex", "owner")
+	if e != nil {
+		t.Fatal("second Connect refused:", e)
+	}
+	if _, e = m.Status(ctx, first.ID, "owner", "codex"); e == nil {
+		t.Fatal("replaced login still pending")
+	}
+	if status, e := m.Status(ctx, second.ID, "owner", "codex"); e != nil || status != "waiting" {
+		t.Fatal(status, e)
+	}
+}
+func TestCallbackByURL(t *testing.T) {
+	m, _ := fixture(t)
+	ctx := context.Background()
+	f, e := m.Start(ctx, "codex", "old-session")
+	if e != nil {
+		t.Fatal(e)
+	}
+	for _, raw := range []string{"http://localhost:1455/auth/callback?state=wrong&code=x", "http://localhost:9999/auth/callback?state=mock-state&code=x", "http://localhost:1455/auth/callback?state=mock-state", "not a url%"} {
+		if _, e = m.CallbackByURL(ctx, raw); e == nil {
+			t.Fatal("accepted", raw)
+		}
+	}
+	provider, e := m.CallbackByURL(ctx, "http://localhost:1455/auth/callback?state=mock-state&code=private")
+	if e != nil || provider != "codex" {
+		t.Fatal(provider, e)
+	}
+	if _, e = m.CallbackByURL(ctx, "http://localhost:1455/auth/callback?state=mock-state&code=private"); e == nil {
+		t.Fatal("replay")
+	}
