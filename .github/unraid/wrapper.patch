+    const row = element('div', ''); row.className = 'usage-row';
+    const head = element('div', ''); head.className = 'usage-head';
+    head.append(element('strong', a.label + (a.plan ? ' · ' + a.plan : '')), element('span', a.disabled ? 'Disabled' : a.status));
