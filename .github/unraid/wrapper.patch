+	cookie := w.Result().Cookies()[0]
+	var login map[string]string
+	_ = json.Unmarshal(w.Body.Bytes(), &login)
+	return m, func(method, path, body string) *httptest.ResponseRecorder {
+		return raw(method, path, body, cookie, login["csrf"])
+	}
