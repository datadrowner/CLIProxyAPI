diff --git a/internal/cliproxy/limits.go b/internal/cliproxy/limits.go
new file mode 100644
index 0000000..2430eaa
--- /dev/null
+++ b/internal/cliproxy/limits.go
@@ -0,0 +1,226 @@
+package cliproxy
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"net/url"
+	"strings"
+	"time"
+)
+
+// Plan is a named token budget that limited keys can reference.
+type Plan struct {
+	Name       string `json:"name"`
+	TokenLimit int64  `json:"token-limit,omitempty"`
+	Period     string `json:"period,omitempty"`
+	// AccountShare is the percentage of each connected account's limit windows a key may use.
+	AccountShare float64 `json:"account-share,omitempty"`
+	// AllowedModels and AllowedEfforts restrict what keys on the plan may request; empty allows all.
+	AllowedModels  []string `json:"allowed-models,omitempty"`
+	AllowedEfforts []string `json:"allowed-efforts,omitempty"`
+}
+
+// LimitedKey is a client API key under access.api-key-limits.
+type LimitedKey struct {
+	Key          string  `json:"key"`
+	Name         string  `json:"name,omitempty"`
+	Subscription string  `json:"subscription,omitempty"`
+	TokenLimit   int64   `json:"token-limit,omitempty"`
+	Period       string  `json:"period,omitempty"`
+	AccountShare float64 `json:"account-share,omitempty"`
+	// AllowedModels and AllowedEfforts override the plan's lists when non-empty.
+	AllowedModels  []string `json:"allowed-models,omitempty"`
+	AllowedEfforts []string `json:"allowed-efforts,omitempty"`
+}
+
+// AccountShare is a key's estimated portion of one account limit window.
+type AccountShare struct {
+	AuthIndex          string    `json:"-"`
+	Account            string    `json:"account"`
+	Window             string    `json:"window"`
+	UsedPercent        float64   `json:"used_percent"`
+	SharePercent       float64   `json:"share_percent"`
+	AccountUsedPercent float64   `json:"account_used_percent"`
+	ResetsAt           time.Time `json:"resets_at"`
+}
+
+// UnmarshalJSON reads the upstream auth_index, which is not passed to the browser.
+func (s *AccountShare) UnmarshalJSON(data []byte) error {
+	type plain AccountShare
+	var raw struct {
+		plain
+		AuthIndex string `json:"auth_index"`
+	}
+	if e := json.Unmarshal(data, &raw); e != nil {
+		return e
+	}
+	*s = AccountShare(raw.plain)
+	s.AuthIndex = raw.AuthIndex
+	return nil
+}
+
+// Limits mirrors access.api-key-limits in the upstream configuration.
+type Limits struct {
+	StateFile     string       `json:"state-file,omitempty"`
+	Subscriptions []Plan       `json:"subscriptions"`
+	Keys          []LimitedKey `json:"keys"`
+}
+
+// KeyUsage is the current budget state of one limited key.
+type KeyUsage struct {
+	ID              string         `json:"id"`
+	Period          string         `json:"period"`
+	Unlimited       bool           `json:"unlimited"`
+	TokenLimit      int64          `json:"token_limit"`
+	UsedTokens      int64          `json:"used_tokens"`
+	RemainingTokens int64          `json:"remaining_tokens"`
+	Requests        int64          `json:"requests"`
+	ResetsAt        time.Time      `json:"resets_at"`
+	AccountShare    float64        `json:"account_share"`
+	AccountShares   []AccountShare `json:"account_shares"`
+}
+
+// UsageRow is one month of usage for a key, credential and model.
+type UsageRow struct {
+	KeyID            string  `json:"key_id"`
+	AuthIndex        string  `json:"auth_index"`
+	Provider         string  `json:"provider"`
+	Model            string  `json:"model"`
+	Requests         int64   `json:"requests"`
+	Failed           int64   `json:"failed"`
+	InputTokens      int64   `json:"input_tokens"`
+	CacheReadTokens  int64   `json:"cache_read_tokens"`
+	CacheWriteTokens int64   `json:"cache_write_tokens"`
+	OutputTokens     int64   `json:"output_tokens"`
+	ReasoningTokens  int64   `json:"reasoning_tokens"`
+	TotalTokens      int64   `json:"total_tokens"`
+	CostUSD          float64 `json:"cost_usd"`
+	UnpricedTokens   int64   `json:"unpriced_tokens"`
+}
+
+// Price is an Anthropic API list price in USD per million tokens.
+type Price struct {
+	Model        string  `json:"model"`
+	Name         string  `json:"name"`
+	Input        float64 `json:"input"`
+	CacheWrite5m float64 `json:"cache_write_5m"`
+	CacheWrite1h float64 `json:"cache_write_1h"`
+	CacheRead    float64 `json:"cache_read"`
+	Output       float64 `json:"output"`
+	Legacy       bool    `json:"legacy,omitempty"`
+	FastMode     bool    `json:"fast_mode,omitempty"`
+	LongPrompt   *struct {
+		Input  float64 `json:"input"`
+		Output float64 `json:"output"`
+	} `json:"long_prompt,omitempty"`
+	LongPromptThreshold int64 `json:"long_prompt_threshold,omitempty"`
+}
+
+// Analytics is one month of usage with key labels and the price table.
+type Analytics struct {
+	Month         string            `json:"month"`
+	Months        []string          `json:"months"`
+	Rows          []UsageRow        `json:"rows"`
+	Keys          map[string]string `json:"keys"`
+	Pricing       []Price           `json:"pricing"`
+	PricingSource string            `json:"pricing_source"`
+	// Days lists the recorded days of the month; Trend lists every retained month, oldest first.
+	Days  []Totals `json:"days"`
+	Trend []Totals `json:"trend"`
+}
+
+// Totals is the usage of one day ("YYYY-MM-DD") or month ("YYYY-MM").
+type Totals struct {
+	Period         string  `json:"period"`
+	Requests       int64   `json:"requests"`
+	TotalTokens    int64   `json:"total_tokens"`
+	CostUSD        float64 `json:"cost_usd"`
+	UnpricedTokens int64   `json:"unpriced_tokens"`
+}
+
+// QuotaWindow is a provider-reported subscription limit window of an account.
+type QuotaWindow struct {
+	Label       string    `json:"label"`
+	UsedPercent float64   `json:"used_percent"`
+	ResetsAt    time.Time `json:"resets_at,omitempty"`
+}
+
+const limitsPath = "/v8/management/config/access/api-key-limits"
+
+// KeyID matches the upstream identifier for a client key (SHA-256 hex prefix).
+func KeyID(key string) string {
+	s := sha256.Sum256([]byte(strings.TrimSpace(key)))
+	return hex.EncodeToString(s[:])[:16]
+}
+
+// Limits reads access.api-key-limits; a missing section is empty.
+func (c *Client) Limits(ctx context.Context) (Limits, error) {
+	var out Limits
+	if e := c.Do(ctx, "GET", limitsPath, nil, &out); e != nil {
+		if errors.Is(e, ErrNotFound) {
+			return Limits{Subscriptions: []Plan{}, Keys: []LimitedKey{}}, nil
+		}
+		return Limits{}, e
+	}
+	if out.Subscriptions == nil {
+		out.Subscriptions = []Plan{}
+	}
+	if out.Keys == nil {
+		out.Keys = []LimitedKey{}
+	}
+	return out, nil
+}
+
+// SaveLimits replaces access.api-key-limits; upstream validates and hot-reloads it.
+func (c *Client) SaveLimits(ctx context.Context, l Limits) error {
+	if l.Subscriptions == nil {
+		l.Subscriptions = []Plan{}
+	}
+	if l.Keys == nil {
+		l.Keys = []LimitedKey{}
+	}
+	return c.Do(ctx, "PUT", limitsPath, l, nil)
+}
+
+// KeyUsage returns the budget state of limited keys by key ID.
+func (c *Client) KeyUsage(ctx context.Context) (map[string]KeyUsage, error) {
+	var out struct {
+		Keys []KeyUsage `json:"keys"`
+	}
+	if e := c.Do(ctx, "GET", "/v8/management/observability/usage/api-key-limits", nil, &out); e != nil {
+		return nil, e
+	}
+	usage := make(map[string]KeyUsage, len(out.Keys))
+	for _, k := range out.Keys {
+		usage[k.ID] = k
+	}
+	return usage, nil
+}
+
+// Analytics returns monthly usage; month is "YYYY-MM" or empty for the current month.
+func (c *Client) Analytics(ctx context.Context, month string) (Analytics, error) {
+	path := "/v8/management/observability/usage/analytics"
+	if month != "" {
+		path += "?" + url.Values{"month": {month}}.Encode()
+	}
+	var out Analytics
+	if e := c.Do(ctx, "GET", path, nil, &out); e != nil {
+		return Analytics{}, e
+	}
+	if out.Rows == nil {
+		out.Rows = []UsageRow{}
+	}
+	if out.Months == nil {
+		out.Months = []string{}
+	}
+	if out.Days == nil {
+		out.Days = []Totals{}
+	}
+	if out.Trend == nil {
+		out.Trend = []Totals{}
+	}
+	return out, nil
+}
diff --git a/internal/cliproxy/quota.go b/internal/cliproxy/quota.go
new file mode 100644
index 0000000..5eef882
--- /dev/null
+++ b/internal/cliproxy/quota.go
@@ -0,0 +1,98 @@
+package cliproxy
+
+import (
+	"math"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// QuotaWindows converts provider rate-limit headers observed by upstream into
+// subscription usage windows. Only numeric fields are read; other header values
+// are ignored.
+//
+// Claude: anthropic-ratelimit-unified-<window>-utilization (0..1) and -reset (unix seconds).
+// Codex: x-codex-<limit>-used-percent (0..100), -window-minutes, -reset-at (unix
+// seconds) or -reset-after-seconds (relative to the observation time).
+func QuotaWindows(signals map[string]string, observedAt time.Time) []QuotaWindow {
+	lower := make(map[string]string, len(signals))
+	for k, v := range signals {
+		lower[strings.ToLower(strings.TrimSpace(k))] = strings.TrimSpace(v)
+	}
+	number := func(key string) (float64, bool) {
+		v, ok := lower[key]
+		if !ok {
+			return 0, false
+		}
+		f, e := strconv.ParseFloat(v, 64)
+		if e != nil || math.IsNaN(f) || math.IsInf(f, 0) {
+			return 0, false
+		}
+		return f, true
+	}
+	unix := func(key string) time.Time {
+		if f, ok := number(key); ok && f > 1e9 && f < 1e11 {
+			return time.Unix(int64(f), 0).UTC()
+		}
+		return time.Time{}
+	}
+	windows := []QuotaWindow{}
+	for key := range lower {
+		switch {
+		case strings.HasPrefix(key, "anthropic-ratelimit-unified-") && strings.HasSuffix(key, "-utilization"):
+			name := strings.TrimSuffix(strings.TrimPrefix(key, "anthropic-ratelimit-unified-"), "-utilization")
+			used, ok := number(key)
+			if !ok || name == "" {
+				continue
+			}
+			windows = append(windows, QuotaWindow{
+				Label:       windowLabel(name),
+				UsedPercent: clampPercent(used * 100),
+				ResetsAt:    unix("anthropic-ratelimit-unified-" + name + "-reset"),
+			})
+		case strings.HasPrefix(key, "x-codex-") && strings.HasSuffix(key, "-used-percent"):
+			base := strings.TrimSuffix(key, "-used-percent")
+			used, ok := number(key)
+			if !ok {
+				continue
+			}
+			label := strings.TrimPrefix(base, "x-codex-")
+			if minutes, okMinutes := number(base + "-window-minutes"); okMinutes && minutes > 0 {
+				label = minutesLabel(minutes) + " (" + label + ")"
+			}
+			resets := unix(base + "-reset-at")
+			if resets.IsZero() && !observedAt.IsZero() {
+				if after, okAfter := number(base + "-reset-after-seconds"); okAfter && after >= 0 && after < 1e8 {
+					resets = observedAt.Add(time.Duration(after) * time.Second).UTC()
+				}
+			}
+			windows = append(windows, QuotaWindow{Label: label, UsedPercent: clampPercent(used), ResetsAt: resets})
+		}
+	}
+	sort.Slice(windows, func(i, j int) bool { return windows[i].Label < windows[j].Label })
+	return windows
+}
+
+func windowLabel(name string) string {
+	name = strings.ReplaceAll(name, "_", " ")
+	if len(name) > 40 {
+		name = name[:40]
+	}
+	return name + " window"
+}
+
+func minutesLabel(minutes float64) string {
+	switch {
+	case minutes >= 1440 && math.Mod(minutes, 1440) == 0:
+		return strconv.Itoa(int(minutes/1440)) + "d"
+	case minutes >= 60 && math.Mod(minutes, 60) == 0:
+		return strconv.Itoa(int(minutes/60)) + "h"
+	default:
+		return strconv.Itoa(int(minutes)) + "m"
+	}
+}
+
+func clampPercent(p float64) float64 {
+	return math.Max(0, math.Min(100, math.Round(p*10)/10))
+}
diff --git a/internal/cliproxy/quota_test.go b/internal/cliproxy/quota_test.go
new file mode 100644
index 0000000..95a1abf
--- /dev/null
+++ b/internal/cliproxy/quota_test.go
@@ -0,0 +1,35 @@
+package cliproxy
+
+import (
+	"testing"
+	"time"
+)
+
+func TestQuotaWindows(t *testing.T) {
+	observed := time.Date(2026, 10, 29, 12, 0, 0, 0, time.UTC)
+	got := QuotaWindows(map[string]string{
+		"Anthropic-Ratelimit-Unified-5h-Utilization": "0.425",
+		"Anthropic-Ratelimit-Unified-5h-Reset":       "1893456000",
+		"Anthropic-Ratelimit-Unified-7d-Utilization": "1.7",
+		"Anthropic-Ratelimit-Unified-Status":         "allowed",
+		"X-Codex-Secondary-Used-Percent":             "12",
+		"X-Codex-Secondary-Window-Minutes":           "10080",
+		"X-Codex-Secondary-Reset-After-Seconds":      "3600",
+		"X-Codex-Primary-Used-Percent":               "not-a-number",
+	}, observed)
+	if len(got) != 3 {
+		t.Fatalf("windows = %+v", got)
+	}
+	if got[0].Label != "5h window" || got[0].UsedPercent != 42.5 || !got[0].ResetsAt.Equal(time.Unix(1893456000, 0)) {
+		t.Fatalf("5h = %+v", got[0])
+	}
+	if got[1].Label != "7d (secondary)" || got[1].UsedPercent != 12 || !got[1].ResetsAt.Equal(observed.Add(time.Hour)) {
+		t.Fatalf("codex = %+v", got[1])
+	}
+	if got[2].Label != "7d window" || got[2].UsedPercent != 100 {
+		t.Fatalf("7d clamp = %+v", got[2])
+	}
+	if len(QuotaWindows(nil, time.Time{})) != 0 {
+		t.Fatal("nil signals")
+	}
+}
