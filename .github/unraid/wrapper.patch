+				return
+			}
+		}
+		limits.Subscriptions = in.Plans
+		if e = s.Client.SaveLimits(ctx, limits); e != nil {
+			problem(w, 502, "Saving plans failed")
+			return
+		}
+		reply(w, 200, map[string]bool{"ok": true})
+	case path == "/api/usage" && r.Method == "GET":
+		s.usageOverview(w, r)
+	case path == "/api/analytics" && r.Method == "GET":
+		month := r.URL.Query().Get("month")
+		if month != "" {
+			if _, e := time.Parse("2006-01", month); e != nil {
+				problem(w, 400, "Month must be YYYY-MM")
+				return
+			}
+		}
+		a, e := s.Client.Analytics(ctx, month)
+		if e != nil {
+			problem(w, 502, "Analytics unavailable")
+			return
+		}
+		a.Keys = s.keyLabels(a.Keys)
+		accounts := map[string]string{}
+		if list, errAccounts := s.Client.Accounts(ctx); errAccounts == nil {
+			for _, acc := range list {
+				accounts[acc.Index] = accountLabel(acc)
+			}
+		}
+		reply(w, 200, map[string]any{"analytics": a, "accounts": accounts})
+	default:
+		problem(w, 404, "Not found")
+	}
+}
+
+// keyLabels names the WebUI main key and falls back to upstream labels.
+func (s *Server) keyLabels(upstream map[string]string) map[string]string {
+	labels := map[string]string{}
+	for id, label := range upstream {
+		labels[id] = label
+	}
+	labels[cliproxy.KeyID(s.Client.Key())] = "Main key (WebUI)"
+	return labels
+}
+
+func accountLabel(a cliproxy.Account) string {
+	if a.Email != "" {
+		return a.Provider + " · " + a.Email
+	}
+	return a.Provider
+}
+
+// usageOverview combines key budgets, this month's analytics and account limits.
+func (s *Server) usageOverview(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	a, e := s.Client.Analytics(ctx, "")
+	if e != nil {
+		problem(w, 502, "Usage unavailable")
+		return
+	}
+	limits, _ := s.Client.Limits(ctx)
+
+	accounts, _ := s.Client.Accounts(ctx)
+
+	type totals struct {
+		Requests int64   `json:"requests"`
+		Tokens   int64   `json:"tokens"`
+		CostUSD  float64 `json:"cost_usd"`
+	}
+	byKey, byAuth := map[string]*totals{}, map[string]*totals{}
+	add := func(m map[string]*totals, id string, row cliproxy.UsageRow) {
+		t := m[id]
+		if t == nil {
+			t = &totals{}
+			m[id] = t
+		}
+		t.Requests += row.Requests
+		t.Tokens += row.TotalTokens
+		t.CostUSD += row.CostUSD
+	}
+	for _, row := range a.Rows {
+		add(byKey, row.KeyID, row)
+		add(byAuth, row.AuthIndex, row)
+	}
+
+	type keyRow struct {
+		keyView
+		Month totals `json:"month"`
+	}
+	keys := []keyRow{}
+	for _, v := range s.keyViews(ctx, limits) {
+		keys = append(keys, keyRow{keyView: v})
+	}
+	for i := range keys {
+		if t := byKey[keys[i].ID]; t != nil {
+			keys[i].Month = *t
+		}
+	}
+
+	type accountRow struct {
+		ID       string                 `json:"id"`
+		Label    string                 `json:"label"`
+		Plan     string                 `json:"plan"`
+		Status   string                 `json:"status"`
+		Disabled bool                   `json:"disabled"`
+		Limits   []cliproxy.QuotaWindow `json:"limits"`
+		// LimitsSource is "live" (fetched from the provider) or "observed" (from response headers).
+		LimitsSource string    `json:"limits_source"`
+		LimitsAt     time.Time `json:"limits_at,omitempty"`
+		LimitsNote   string    `json:"limits_note,omitempty"`
+		Month        totals    `json:"month"`
+	}
+	live := s.planUsage(ctx, accounts, r.URL.Query().Get("refresh") == "1")
+	rows := []accountRow{}
+	for _, acc := range accounts {
+		row := accountRow{ID: acc.ID, Label: accountLabel(acc), Plan: acc.Plan, Status: acc.Status, Disabled: acc.Disabled, Limits: acc.Limits}
+		if len(row.Limits) > 0 {
+			row.LimitsSource = "observed"
+		}
+		if u, ok := live[acc.Index]; ok {
+			if u.err == "" {
+				row.Limits, row.LimitsSource, row.LimitsAt = u.windows, "live", u.at
+			} else {
+				row.LimitsNote = u.err
+			}
+		}
+		if row.Limits == nil {
+			row.Limits = []cliproxy.QuotaWindow{}
+		}
+		if t := byAuth[acc.Index]; t != nil {
+			row.Month = *t
+		}
+		rows = append(rows, row)
+	}
+	reply(w, 200, map[string]any{"month": a.Month, "keys": keys, "accounts": rows})
+}
+
+// planUsageTTL bounds how often each account's plan usage is fetched from the provider.
+const planUsageTTL = 60 * time.Second
+
+type cachedUsage struct {
+	at      time.Time
+	windows []cliproxy.QuotaWindow
+	err     string
+}
+
+// planUsage fetches live plan usage (5-hour and weekly windows) for enabled
+// Claude accounts in parallel, caching results and failures for planUsageTTL.
+func (s *Server) planUsage(ctx context.Context, accounts []cliproxy.Account, force bool) map[string]cachedUsage {
+	out := map[string]cachedUsage{}
+	var mu sync.Mutex
+	var wg sync.WaitGroup
+	for _, acc := range accounts {
+		if !strings.EqualFold(acc.Provider, "claude") || acc.Disabled || acc.Index == "" {
+			continue
+		}
+		s.usageMu.Lock()
+		cached, ok := s.usageCache[acc.Index]
+		s.usageMu.Unlock()
+		if ok && !force && time.Since(cached.at) < planUsageTTL {
+			out[acc.Index] = cached
+			continue
+		}
+		wg.Add(1)
+		go func(index string) {
+			defer wg.Done()
+			windows, e := s.Client.ClaudeUsage(ctx, index)
+			result := cachedUsage{at: time.Now().UTC(), windows: windows}
+			if e != nil {
+				result.err = "Plan usage could not be loaded from Anthropic right now; showing the last observed values if any."
+			}
+			s.usageMu.Lock()
+			if s.usageCache == nil {
+				s.usageCache = map[string]cachedUsage{}
+			}
+			s.usageCache[index] = result
+			s.usageMu.Unlock()
+			mu.Lock()
+			out[index] = result
+			mu.Unlock()
+		}(acc.Index)
+	}
+	wg.Wait()
+	return out
+}
