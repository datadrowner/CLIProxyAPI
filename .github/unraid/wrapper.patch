+  const now = new Date(), current = a.month === now.toISOString().slice(0, 7);
+  const cards = [card('API cost', usdText(all.cost), 'At Anthropic list prices'), card('Tokens', tokensText(all.total), fmtInt.format(all.requests) + ' requests')];
+  if (current) {
+    const start = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), 1), end = Date.UTC(now.getUTCFullYear(), now.getUTCMonth() + 1, 1);
+    const fraction = Math.max((now - start) / (end - start), 1 / 31);
