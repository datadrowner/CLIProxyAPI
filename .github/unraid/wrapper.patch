+		defer s.limitsMu.Unlock()
+		limits, e := s.Client.Limits(ctx)
+		if e != nil {
+			problem(w, 502, "Key limits unavailable")
+			return
+		}
+		created := ""
+		switch r.Method {
+		case "POST":
+			if msg := validLimit(in, limits.Subscriptions); msg != "" {
+				problem(w, 400, msg)
+				return
+			}
+			if len(limits.Keys) >= 200 {
+				problem(w, 400, "Too many keys")
+				return
+			}
+			key, errKey := bootstrap.Secret("sk-cpa-")
+			if errKey != nil {
+				problem(w, 500, "Could not generate a key")
+				return
+			}
+			limits.Keys = append(limits.Keys, cliproxy.LimitedKey{Key: key, Name: in.Name, Subscription: in.Subscription, TokenLimit: in.TokenLimit, Period: in.Period, AccountShare: in.AccountShare, AllowedModels: in.Models, AllowedEfforts: in.Efforts})
+			created = key
+		case "PATCH", "DELETE":
+			idx := -1
+			for i, k := range limits.Keys {
+				if cliproxy.KeyID(k.Key) == in.ID {
+					idx = i
+				}
+			}
+			if idx < 0 {
+				problem(w, 404, "Unknown key")
+				return
+			}
+			if r.Method == "DELETE" {
+				if !in.Confirm {
+					problem(w, 400, "Confirm deletion first")
+					return
+				}
+				limits.Keys = append(limits.Keys[:idx], limits.Keys[idx+1:]...)
+				break
+			}
+			if msg := validLimit(in, limits.Subscriptions); msg != "" {
+				problem(w, 400, msg)
+				return
+			}
+			k := &limits.Keys[idx]
+			k.Name, k.Subscription, k.TokenLimit, k.Period, k.AccountShare = in.Name, in.Subscription, in.TokenLimit, in.Period, in.AccountShare
+			k.AllowedModels, k.AllowedEfforts = in.Models, in.Efforts
+		default:
+			problem(w, 405, "Method not allowed")
+			return
+		}
+		if e = s.Client.SaveLimits(ctx, limits); e != nil {
+			problem(w, 502, "Saving key limits failed")
+			return
+		}
+		if created != "" {
+			reply(w, 200, map[string]string{"id": cliproxy.KeyID(created), "key": created})
+			return
+		}
+		reply(w, 200, map[string]bool{"ok": true})
+	case strings.HasPrefix(path, "/api/limits/keys/") && r.Method == "GET":
+		id := strings.TrimPrefix(path, "/api/limits/keys/")
+		limits, e := s.Client.Limits(ctx)
+		if e != nil {
+			problem(w, 502, "Key limits unavailable")
+			return
+		}
+		for _, k := range limits.Keys {
+			if cliproxy.KeyID(k.Key) == id {
+				reply(w, 200, map[string]string{"key": k.Key})
+				return
+			}
+		}
+		problem(w, 404, "Unknown key")
+	case path == "/api/limits/plans" && r.Method == "PUT":
+		var in struct {
+			Plans []cliproxy.Plan `json:"plans"`
+		}
+		if !decode(w, r, &in) {
+			return
+		}
+		seen := map[string]bool{}
+		for i := range in.Plans {
+			p := &in.Plans[i]
+			p.Name, p.Period = strings.TrimSpace(p.Name), strings.TrimSpace(p.Period)
+			if !planName.MatchString(p.Name) || seen[p.Name] {
+				problem(w, 400, "Plan names must be unique: letters, digits, space, dot, dash or underscore")
+				return
+			}
+			if p.TokenLimit < 0 || p.TokenLimit > 1e13 || !validPeriod(p.Period) || p.AccountShare < 0 || p.AccountShare > 100 {
+				problem(w, 400, "Invalid plan limit or period")
+				return
+			}
+			p.AllowedModels, p.AllowedEfforts = cleanList(p.AllowedModels), cleanList(p.AllowedEfforts)
+			if msg := validAccess(p.AllowedModels, p.AllowedEfforts); msg != "" {
+				problem(w, 400, msg)
+				return
+			}
+			seen[p.Name] = true
+		}
+		if len(in.Plans) > 50 {
+			problem(w, 400, "Too many plans")
+			return
+		}
+		s.limitsMu.Lock()
+		defer s.limitsMu.Unlock()
+		limits, e := s.Client.Limits(ctx)
+		if e != nil {
