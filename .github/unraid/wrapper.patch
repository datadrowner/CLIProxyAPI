 package mock
 
 import (
+	"crypto/sha256"
+	"encoding/hex"
 	"encoding/json"
+	"io"
 	"net/http"
 	"net/url"
 	"os"
@@ -15,6 +18,17 @@ type Server struct {
 	mu                          sync.Mutex
