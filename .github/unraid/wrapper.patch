diff --git a/internal/cliproxy/claude_usage.go b/internal/cliproxy/claude_usage.go
new file mode 100644
index 0000000..608f1f2
--- /dev/null
+++ b/internal/cliproxy/claude_usage.go
@@ -0,0 +1,111 @@
+package cliproxy
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"math"
+	"sort"
+	"strings"
+	"time"
+)
+
+// claudeUsageURL is the endpoint Claude Code's /usage reads for subscription
+// accounts. It is not a documented public API, so responses are parsed defensively.
+const claudeUsageURL = "https://api.anthropic.com/api/oauth/usage"
+
+var claudeWindowLabels = map[string]string{
+	"five_hour":            "5-hour limit",
+	"seven_day":            "Weekly limit",
+	"seven_day_sonnet":     "Weekly limit (Sonnet)",
+	"seven_day_opus":       "Weekly limit (Opus)",
+	"seven_day_oauth_apps": "Weekly limit (OAuth apps)",
+}
+
+var claudeWindowOrder = map[string]int{"five_hour": 0, "seven_day": 1}
+
+// ClaudeUsage asks upstream to read a Claude account's plan usage with that
+// account's own OAuth token; the token is substituted server-side and never
+// reaches this process.
+func (c *Client) ClaudeUsage(ctx context.Context, authIndex string) ([]QuotaWindow, error) {
+	if strings.TrimSpace(authIndex) == "" {
+		return nil, errors.New("account has no auth index")
+	}
+	req := map[string]any{
+		"auth_index": authIndex,
+		"method":     "GET",
+		"url":        claudeUsageURL,
+		"header": map[string]string{
+			"Authorization":  "Bearer $TOKEN$",
+			"anthropic-beta": "oauth-2025-04-20",
+			"Accept":         "application/json",
+		},
+	}
+	var out struct {
+		StatusCode int    `json:"status_code"`
+		Body       string `json:"body"`
+	}
+	if e := c.Do(ctx, "POST", "/v8/management/requests/api-call", req, &out); e != nil {
+		return nil, e
+	}
+	if out.StatusCode != 200 {
+		return nil, errors.New("Anthropic usage request failed")
+	}
+	return parseClaudeUsage([]byte(out.Body))
+}
+
+// parseClaudeUsage reads every top-level object that has a numeric
+// "utilization" (percent) and an optional "resets_at" (RFC 3339).
+func parseClaudeUsage(body []byte) ([]QuotaWindow, error) {
+	var raw map[string]json.RawMessage
+	if e := json.Unmarshal(body, &raw); e != nil {
+		return nil, errors.New("invalid Anthropic usage response")
+	}
+	type keyed struct {
+		key string
+		w   QuotaWindow
+	}
+	found := []keyed{}
+	for key, value := range raw {
+		var window struct {
+			Utilization *float64 `json:"utilization"`
+			ResetsAt    *string  `json:"resets_at"`
+		}
+		if json.Unmarshal(value, &window) != nil || window.Utilization == nil || math.IsNaN(*window.Utilization) {
+			continue
+		}
+		label := claudeWindowLabels[key]
+		if label == "" {
+			if len(key) > 40 {
+				continue
+			}
+			label = strings.ReplaceAll(key, "_", " ")
+		}
+		w := QuotaWindow{Label: label, UsedPercent: clampPercent(*window.Utilization)}
+		if window.ResetsAt != nil {
+			if t, e := time.Parse(time.RFC3339, *window.ResetsAt); e == nil {
+				w.ResetsAt = t.UTC()
+			}
+		}
+		found = append(found, keyed{key, w})
+	}
+	if len(found) == 0 {
+		return nil, errors.New("Anthropic usage response has no limit windows")
+	}
+	sort.Slice(found, func(i, j int) bool {
+		oi, okI := claudeWindowOrder[found[i].key]
+		oj, okJ := claudeWindowOrder[found[j].key]
+		switch {
+		case okI && okJ:
+			return oi < oj
+		case okI != okJ:
+			return okI
+		}
+		return found[i].key < found[j].key
+	})
+	windows := make([]QuotaWindow, len(found))
+	for i, f := range found {
+		windows[i] = f.w
+	}
+	return windows, nil
+}
diff --git a/internal/cliproxy/claude_usage_test.go b/internal/cliproxy/claude_usage_test.go
new file mode 100644
index 0000000..b0baa9c
--- /dev/null
+++ b/internal/cliproxy/claude_usage_test.go
@@ -0,0 +1,24 @@
+package cliproxy
+
+import (
+	"testing"
+	"time"
+)
+
+func TestParseClaudeUsage(t *testing.T) {
+	got, e := parseClaudeUsage([]byte(`{"seven_day_sonnet":{"utilization":4,"resets_at":null},"seven_day":{"utilization":61.25,"resets_at":"2030-01-05T00:00:00+00:00"},"five_hour":{"utilization":23.5,"resets_at":"2030-01-01T05:00:00Z"},"seven_day_opus":null,"extra_usage":{"is_enabled":false},"overflow":{"utilization":250}}`))
+	if e != nil {
+		t.Fatal(e)
+	}
+	if len(got) != 4 || got[0].Label != "5-hour limit" || got[1].Label != "Weekly limit" || got[2].Label != "overflow" || got[3].Label != "Weekly limit (Sonnet)" {
+		t.Fatalf("windows = %+v", got)
+	}
+	if got[0].UsedPercent != 23.5 || !got[0].ResetsAt.Equal(time.Date(2030, 1, 1, 5, 0, 0, 0, time.UTC)) || got[1].UsedPercent != 61.3 || got[2].UsedPercent != 100 || !got[3].ResetsAt.IsZero() {
+		t.Fatalf("values = %+v", got)
+	}
+	for _, body := range []string{`not json`, `{}`, `{"five_hour":null}`} {
+		if _, e := parseClaudeUsage([]byte(body)); e == nil {
+			t.Fatalf("accepted %s", body)
+		}
+	}
+}
